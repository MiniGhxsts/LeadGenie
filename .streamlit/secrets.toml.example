# Streamlit Secrets Template for Community Cloud
# In your Streamlit Cloud App Settings -> Secrets, copy and paste these keys with your real values:

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-supabase-anon-key"
PLACES_API_KEY = "your-google-places-api-key"
GEMINI_API_KEY = "your-gemini-api-key"

# Optional: Lemon Squeezy Checkout links
LEMON_SQUEEZY_STARTER_URL = "https://yourstore.lemonsqueezy.com/buy/starter-variant-id"
LEMON_SQUEEZY_PRO_URL = "https://yourstore.lemonsqueezy.com/buy/pro-variant-id"
